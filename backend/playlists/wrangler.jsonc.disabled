{
  "name": "tuz19-playlists",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "tuz19.ru/api/playlists*", "zone_name": "tuz19.ru"}],
  "triggers": {"crons": []},
  "observability": {"enabled": false},
  "d1_databases": [{
    "binding": "PLAYLIST_DB",
    "database_name": "tuz19-playlists",
    "database_id": "REPLACE_WITH_CREATED_D1_UUID",
    "migrations_dir": "migrations"
  }]
}
